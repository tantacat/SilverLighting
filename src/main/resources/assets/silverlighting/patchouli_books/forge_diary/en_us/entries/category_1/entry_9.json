			"left_3": "flammpfeil.slashblade:slashblade:50",
			"right_3": "flammpfeil.slashblade:proudsoul:1",
			"output_3": "flammpfeil.slashblade:slashblade:20{ProudSoul:400,RepairCounter:1}",
			
			"left_4": "flammpfeil.slashblade:slashblade:50",
			"right_4": "flammpfeil.slashblade:proudsoul:2",
			"output_4": "flammpfeil.slashblade:slashblade:15{ProudSoul:400,RepairCounter:1}",
			
			"left_5": "flammpfeil.slashblade:slashblade:50",
			"right_5": "flammpfeil.slashblade:proudsoul:4",
			"output_5": "flammpfeil.slashblade:slashblade{ProudSoul:500,RepairCounter:1}",
			
			"left_6": "flammpfeil.slashblade:slashblade:50",
			"right_6": "flammpfeil.slashblade:proudsoul:5",
			"output_6": "flammpfeil.slashblade:slashblade{ProudSoul:500,RepairCounter:1}"
		},
        {
			"advancement": "silverlighting:proudsoul/tinysoul",
            "type": "text",
            "title": "铸铁",
            "text": "在合适的条件下，耀魂碎片可以被融化为液态，但这个状态的耀魂碎片会迅速挥发。$(br2)不过，只要有一个引子，就能让耀魂碎片的根本性质发生变化……$(br2)你向其中投入了精炼的铁锭。铁锭吸收了液态的耀魂，获得了与耀魂碎片相似但不完全相同的性质。$(br2)就叫它耀魂铁锭吧。"
        },
        {
			"advancement": "silverlighting:proudsoul/tinysoul",
            "type": "crafting",
            "recipe": "flammpfeil.slashblade:ps_soul2ingot",
            "recipe2": "flammpfeil.slashblade:ps_tiny2ingot"
        },
        {
			"advancement": "silverlighting:proudsoul/soulsphere",
            "type": "smelting",
            "title": "宝珠",
            "recipe": "flammpfeil.slashblade:proudsoul:1",
            "text": "将耀魂铁锭再度精炼，最终呈现在你手中的是一枚小巧的宝珠。你能感受到这其中蕴含的巨大力量，但你还难以将其引出。$(br2)你将耀魂宝珠收起。假以时日，它一定会发挥出它应有的作用。"
        }
    ]
